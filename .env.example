# Khmer AI Dubbing Studio - Environment Configuration
# Backend Server Port
PORT=5000
NODE_ENV=development

# Google Gemini API Key for Chinese ASR, Vision OCR, and Khmer Translation
GEMINI_API_KEY=your_gemini_api_key_here

# Khmer Neural Voice Defaults (Microsoft Edge Neural TTS)
DEFAULT_VOICE_MALE=km-KH-PisethNeural
DEFAULT_VOICE_FEMALE=km-KH-SreymomNeural

# Storage Directory Path (Relative to backend/ or absolute path)
STORAGE_DIR=../storage

# Processing & Chunking Configuration
CHUNK_DURATION_SEC=300
CHUNK_OVERLAP_SEC=2
MAX_CONCURRENT_CHUNKS=2

