# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Personal Telegram User ID (get from @userinfobot or /myid)
ADMIN_CHAT_ID=your_admin_chat_id

# Your VIP Group / Channel ID (e.g. -100xxxxxxxxxx)
VIP_CHANNEL_ID=-100xxxxxxxxxx

# Pricing & Duration
PLAN_NAME=Dragon Town VIP 1 Month
SUBSCRIPTION_PRICE_USD=1.00
SUBSCRIPTION_PRICE_KHR=4,000
SUBSCRIPTION_DAYS=30

# Bank info for display when user types /start
BANK_NAME=ABA Bank
ACCOUNT_NAME=YOUR NAME
ACCOUNT_USD=000 000 000
ACCOUNT_KHR=000 000 000

# Path to your KHQR image inside telegram_vip_bot/
KHQR_IMAGE_PATH=assets/khqr.jpg
